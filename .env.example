SGI_APP_NAME=Backend Starter Template
SGI_APP_DESCRIPTION=Reusable FastAPI starter with auth, users and operational defaults
SGI_APP_VERSION=0.2.0
SGI_API_V1_PREFIX=/api/v1

SGI_ENV=dev
SGI_DEBUG=false
SGI_LOG_LEVEL=INFO

SGI_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/starter_db
SGI_DATABASE_ECHO=false

SGI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SGI_CORS_ALLOW_CREDENTIALS=true

SGI_JWT_SECRET_KEY=change-me-with-at-least-32-characters
SGI_JWT_ALGORITHM=HS256
SGI_ACCESS_TOKEN_EXPIRE_MINUTES=15
SGI_REFRESH_TOKEN_EXPIRE_DAYS=7

SGI_ALLOW_OPEN_REGISTRATION=true
SGI_AUTO_PROMOTE_FIRST_USER_TO_ADMIN=true

SGI_INITIAL_ADMIN_EMAIL=
SGI_INITIAL_ADMIN_PASSWORD=
SGI_INITIAL_ADMIN_FULL_NAME=Initial Admin

SGI_DOCS_ENABLED=true
SGI_DOCS_URL=/docs
SGI_REDOC_URL=/redoc
SGI_OPENAPI_URL=/openapi.json

SGI_METRICS_ENABLED=true
SGI_METRICS_PATH=/metrics
SGI_METRICS_NAMESPACE=starter
SGI_METRICS_SUBSYSTEM=api

SGI_SENTRY_DSN=
SGI_SENTRY_SEND_DEFAULT_PII=false
SGI_SENTRY_ENABLE_LOGS=false
SGI_SENTRY_TRACES_SAMPLE_RATE=0.0
SGI_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
